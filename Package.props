<Project>
  
  <PropertyGroup Label="Versions">
    <IsPackable>true</IsPackable>
    
    <BaseVersion>$(MasterVersion.Split(`-`)[0])</BaseVersion>

    <Version>$(MasterVersion)</Version>
    <PackageVersion>$(MasterVersion)</PackageVersion>
    <AssemblyVersion>$(BaseVersion)</AssemblyVersion>
    <AssemblyFileVersion>$(MasterVersion)</AssemblyFileVersion>
    <AssemblyInformationalVersion>$(MasterVersion)</AssemblyInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  
</Project>